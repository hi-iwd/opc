<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <referenceContainer name="head.additional">
        <block class="Magento\Framework\View\Element\Template"
               name="iwd_osc_design"
               template="IWD_OneStepCheckout::checkout-design.phtml">
            <arguments>
                <argument name="view_model" xsi:type="object">IWD\OneStepCheckout\ViewModel\DesignConfig</argument>
            </arguments>
        </block>
        <block class="IWD\OneStepCheckout\Block\BodyClass" name="iwd_osc_body_class"/>
    </referenceContainer>
    <body>
        <referenceContainer name="checkout.header.wrapper">
            <block class="Magento\Framework\View\Element\Template"
                   name="iwd_osc_secure_badge"
                   template="IWD_OneStepCheckout::secure-badge.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">IWD\OneStepCheckout\ViewModel\CheckoutHeader</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="iwd_osc_checkout_header"
                   template="IWD_OneStepCheckout::checkout-header.phtml"
                   before="checkout.root">
                <arguments>
                    <argument name="view_model" xsi:type="object">IWD\OneStepCheckout\ViewModel\CheckoutHeader</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template"
                   name="iwd_osc_express_pay"
                   template="IWD_OneStepCheckout::express-pay.phtml"
                   after="iwd_osc_checkout_header"
                   before="checkout.root">
                <arguments>
                    <argument name="view_model" xsi:type="object">IWD\OneStepCheckout\ViewModel\CheckoutHeader</argument>
                </arguments>
                <block class="Magento\Catalog\Block\ShortcutButtons"
                       name="iwd_osc_express_pay.shortcuts"/>
            </block>
            <block class="Magento\Framework\View\Element\Template"
                   name="iwd_osc_checkout_skeleton"
                   template="IWD_OneStepCheckout::checkout-skeleton.phtml"
                   after="iwd_osc_express_pay"
                   before="checkout.root">
                <arguments>
                    <argument name="view_model" xsi:type="object">IWD\OneStepCheckout\ViewModel\CheckoutHeader</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template"
                   name="iwd_osc_checkout_footnote"
                   template="IWD_OneStepCheckout::checkout-footnote.phtml"
                   after="checkout.root">
                <arguments>
                    <argument name="view_model" xsi:type="object">IWD\OneStepCheckout\ViewModel\CheckoutHeader</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
