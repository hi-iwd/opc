/** @var \IWD\OneStepCheckout\ViewModel\CheckoutHeader $viewModel */
$viewModel = $block->getData('view_model');

if (!$viewModel || !$viewModel->isEnabled()) {
    return;
}
?>
<div class="iwd-osc-express-pay">
    <div class="iwd-osc-express-pay__divider iwd-osc-express-pay__divider--top">
        <span><?= $escaper->escapeHtml(__('Express checkout')) ?></span>
    </div>
    <div class="iwd-osc-express-pay__buttons"><?= $block->getChildHtml() ?></div>
    <div class="iwd-osc-express-pay__divider">
        <span><?= $escaper->escapeHtml(__('or continue below')) ?></span>
    </div>
</div>
