<?php
/**
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
declare(strict_types=1);

/** @var \IWD\OneStepCheckout\ViewModel\CheckoutHeader $viewModel */
$viewModel = $block->getData('view_model');

if (!$viewModel || !$viewModel->isEnabled()) {
    return;
}

$autoSave = $viewModel->isAutoSaveShipping();
$isMultiStep = $viewModel->isMultiStep();
$termsUrl = $viewModel->getTermsUrl();
$privacyUrl = $viewModel->getPrivacyUrl();

$termsFragment = $termsUrl !== ''
    ? '<a href="' . $termsUrl . '">' . __('Terms of Service') . '</a>'
    : (string)__('Terms of Service');
$privacyFragment = $privacyUrl !== ''
    ? '<a href="' . $privacyUrl . '">' . __('Privacy Policy') . '</a>'
    : (string)__('Privacy Policy');

$legal = __($viewModel->getLegalTemplate($autoSave), $termsFragment, $privacyFragment);

$termsShort = $termsUrl !== ''
    ? '<a href="' . $termsUrl . '">' . __('Terms') . '</a>'
    : (string)__('Terms');
$legalCompact = __($viewModel->getLegalCompactTemplate($autoSave), $termsShort, $privacyFragment);
?>
<div class="iwd-osc-footnote">
    <?php if ($isMultiStep): ?>
        <p class="iwd-osc-footnote__legal iwd-osc-footnote__legal--full"><?= $escaper->escapeHtml($legal, ['a']) ?></p>
        <p class="iwd-osc-footnote__legal iwd-osc-footnote__legal--compact"><?= $escaper->escapeHtml($legalCompact, ['a']) ?></p>
        <ul class="iwd-osc-footnote__trust">
