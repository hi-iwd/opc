            <li class="iwd-osc-footnote__trust-item">
                <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.3" d="M13.6 8a5.6 5.6 0 1 1-1.7-4M13.6 2v3.2h-3.2"/></svg>
                <?= $escaper->escapeHtml($viewModel->getMsTrustProtection()) ?>
            </li>
        </ul>
    <?php else: ?>
    <p class="iwd-osc-footnote__legal iwd-osc-footnote__legal--full"><?= $escaper->escapeHtml($legal, ['a']) ?></p>
    <p class="iwd-osc-footnote__legal iwd-osc-footnote__legal--compact"><?= $escaper->escapeHtml($legalCompact, ['a']) ?></p>
